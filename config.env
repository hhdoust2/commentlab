# کلید OpenRouter خودتان را بعد از = بنویسید (بدون فاصله و بدون گیومه)
OPENROUTER_API_KEY=

# مدل ارزان برای دسته‌بندی. اگر اسمش در OpenRouter عوض شد، اینجا عوض کنید.
MODEL=google/gemini-2.5-flash-lite

# قیمت مدل به دلار برای هر یک میلیون توکن (از صفحه‌ی مدل در OpenRouter بردارید)
# فقط برای محاسبه‌ی هزینه در صفحه استفاده می‌شود.
PRICE_IN_PER_M=0.10
PRICE_OUT_PER_M=0.40

# تعداد کامنت در هر درخواست به AI
BATCH_SIZE=40

# پورت برنامه (۳۰۰۰ را عمداً استفاده نکردیم تا با پروژه‌های دیگر تداخل نکند)
PORT=3100
